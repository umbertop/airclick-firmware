# AirClick replacement firmware defaults (ESP32-C3)
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# Wi-Fi / networking
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_NETIF_L2_TAP=n

# HTTP server
CONFIG_ESP_HTTP_SERVER_ENABLE=y

# MQTT (ESP-MQTT)
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# NVS
CONFIG_NVS_ENCRYPTION=n

# Event loop (default event loop)
CONFIG_ESP_EVENT_LOOP_ENABLE=y

# Misc
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

# Console via the native USB (USB-Serial-JTAG) so logs are visible over the
# ESP32-C3's USB port (matches the original firmware).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
